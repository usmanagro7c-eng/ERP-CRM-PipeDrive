# Copy to .env (local dev) or set these as secrets/environment variables on your host.
# NEVER commit real values: every value below must stay EMPTY.
# `npm run check:secrets` fails when a placeholder is filled in.

# Frappe CRM site this app talks to (dev03)
# Example: FRAPPE_BASE_URL=https://dev03.example.pk
FRAPPE_BASE_URL=

# API key/secret of a dedicated integration user ON THE CRM SITE (dev03),
# with only read/write permission on "CRM Organization" (+ read on its Link doctypes).
# Generate them in Frappe under Settings -> API Access -> Generate Keys.
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# Random string, 32+ characters, used to sign login cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Who may sign in (they log in with their Frappe username + password).
# Comma-separated Frappe user ids (emails). Use * to allow any valid Frappe user.
# Example: ALLOWED_USERS=you@example.com
ALLOWED_USERS=

# ERPNext site for Items, Quotations, and Sales Orders (dev06)
# Example: ERPNEXT_BASE_URL=https://dev06.example.pk
ERPNEXT_BASE_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
