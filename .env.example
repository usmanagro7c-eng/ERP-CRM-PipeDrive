# Copy to .env (local dev) or set these as secrets/environment variables on your host
# Copy to .env (local dev) or set these as secrets/environment variables on your host. NEVER commit real values.

# Frappe CRM site this app talks to
FRAPPE_BASE_URL=https://example.pk

# API key/secret of a dedicated integration user ON THE CRM SITE (dev03),
# with only read/write permission on "CRM Organization" (+ read on its Link doctypes).
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# Random string, 32+ characters, used to sign login cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Who may sign in (they log in with their Frappe username + password).
# Comma-separated Frappe user ids (emails). Use * to allow any valid Frappe user.
ALLOWED_USERS=you@example.com
